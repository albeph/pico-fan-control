{
  "_comment": "Configurazione pico-fan-control - Copiare in /etc/pico-fan/config.json e personalizzare",
  "_note": "Eseguire 'pico-fan-setup' per configurare automaticamente",

  "pico_serial_by_id": "/dev/serial/by-id/usb-MicroPython_Board_in_FS_mode_e661640843819a28-if00",

  "control_source": "rpm",

  "ibm_fan_path": "/proc/acpi/ibm/fan",

  "hwmon_fan_path": "",

  "hwmon_temp_path": "",

  "rpm_threshold_high": 4000,
  "rpm_threshold_mid":  2500,

  "temp_threshold_high": 80,
  "temp_threshold_mid":  60,

  "duty_high":          100,
  "duty_mid":           50,
  "duty_low":           0,

  "poll_interval":      2.0,
  "reconnect_interval": 5.0,

  "_doc_pico_serial_by_id":  "Path stabile in /dev/serial/by-id/ del Raspberry Pi Pico. Generato da pico-fan-setup.",
  "_doc_control_source":     "Sorgente di controllo: 'rpm' (ventola interna) o 'temp' (sensore temperatura)",
  "_doc_ibm_fan_path":       "Path per ThinkPad ACPI fan. Default: /proc/acpi/ibm/fan",
  "_doc_hwmon_fan_path":     "Path sysfs fan hwmon. Lasciare vuoto per auto-rilevamento.",
  "_doc_hwmon_temp_path":    "Path sysfs del sensore di temperatura. Lasciare vuoto per auto-rilevamento.",
  "_doc_rpm_threshold_high": "RPM interni sopra cui la ventola esterna va al duty_high (solo modalità rpm)",
  "_doc_rpm_threshold_mid":  "RPM interni sopra cui la ventola esterna va al duty_mid (solo modalità rpm)",
  "_doc_temp_threshold_high":"Temperatura (°C) sopra cui la ventola esterna va al duty_high (solo modalità temp)",
  "_doc_temp_threshold_mid": "Temperatura (°C) sopra cui la ventola esterna va al duty_mid (solo modalità temp)",
  "_doc_duty_high":          "Duty cycle (%) per soglia alta",
  "_doc_duty_mid":           "Duty cycle (%) per soglia media",
  "_doc_duty_low":           "Duty cycle (%) per soglia bassa",
  "_doc_poll_interval":      "Intervallo (secondi) tra le letture",
  "_doc_reconnect_interval": "Intervallo (secondi) tra tentativi di riconnessione USB"
