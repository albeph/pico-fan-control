# systemd/pico-fan.service - Systemd service unit for pico-fan daemon
# ===================================================================
# Manages the pico-fan background daemon, providing automatic startup
# at system boot and crash recovery.

[Unit]
Description=Pico Fan Control Daemon - USB Fan Sync via Raspberry Pi Pico
Documentation=https://github.com/albeph/pico-fan-control
After=network.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
StartLimitIntervalSec=120
StartLimitBurst=5
ConditionPathExists=/etc/pico-fan/config.json

# Automatic restart if daemon crashes (excluding clean manual stop)
[Service]
Type=simple
User=root
Group=root

# Path to installed CLI wrapper launching daemon
ExecStart=/usr/bin/pico-fan daemon

# Automatic restart on failure with backoff interval
Restart=on-failure
RestartSec=10s

# Logging directed to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pico-fan

# Permissions and security sandboxing
PrivateTmp=false
ProtectSystem=false
NoNewPrivileges=true

# Environment variables
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
