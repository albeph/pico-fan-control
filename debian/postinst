#!/bin/sh
# debian/postinst - Post-installation script for pico-fan
# =======================================================
# Automatically executed by dpkg after package installation.
# Responsibilities:
#   1. Prepare systemd daemon service
#   2. Create configuration directory

set -e

PACKAGE_NAME="pico-fan"
INSTALL_LIB="/usr/lib/pico-fan"
CONFIG_DIR="/etc/pico-fan"

# Colors (optional, only in interactive terminal)
if [ -t 1 ]; then
    GREEN="\033[92m"
    YELLOW="\033[93m"
    RED="\033[91m"
    RESET="\033[0m"
    BOLD="\033[1m"
else
    GREEN="" YELLOW="" RED="" RESET="" BOLD=""
fi

info()    { echo "${BOLD}${GREEN}[pico-fan]${RESET} $*"; }
warning() { echo "${BOLD}${YELLOW}[pico-fan] AVVISO:${RESET} $*"; }
error()   { echo "${BOLD}${RED}[pico-fan] ERRORE:${RESET} $*" >&2; }

# ---------------------------------------------------------------------------
# Function: systemd configuration
# ---------------------------------------------------------------------------
systemd_setup() {
    if command -v systemctl > /dev/null 2>&1; then
        info "Ricarica configurazione systemd ..."
        systemctl daemon-reload

        if [ -n "$1" ] && [ -f "${CONFIG_DIR}/config.json" ]; then
            info "Riavvio servizio pico-fan dopo l'aggiornamento ..."
            systemctl restart pico-fan.service 2>/dev/null || \
                warning "Impossibile riavviare il servizio systemd"
        else
            info "Servizio pico-fan pronto: verrà avviato al termine della configurazione."
        fi
    else
        warning "systemd non disponibile."
    fi
}

# ---------------------------------------------------------------------------
# Function: create configuration directory
# ---------------------------------------------------------------------------
config_setup() {
    if [ ! -d "${CONFIG_DIR}" ]; then
        mkdir -p "${CONFIG_DIR}"
        chmod 755 "${CONFIG_DIR}"
        info "Directory configurazione creata: ${CONFIG_DIR}"
    fi

    # Create example configuration if none exists
    if [ ! -f "${CONFIG_DIR}/config.json" ] && \
       [ -f "${INSTALL_LIB}/config.json.example" ]; then
        cp "${INSTALL_LIB}/config.json.example" "${CONFIG_DIR}/config.json.example"
        info "Template configurazione: ${CONFIG_DIR}/config.json.example"
    fi
}

# ===========================================================================
# Main
# ===========================================================================
case "$1" in
    configure)
        info "=== Post-installazione pico-fan ==="

        config_setup
        systemd_setup "$2"

        echo ""
        # $2 is the previous version during upgrade, empty on initial install
        if [ -z "$2" ]; then
            info "=== Installazione completata! ==="
            echo ""
            echo "  Prossimi passi:"
            echo "  1. Collegare il Raspberry Pi Pico via USB"
            echo "  2. Eseguire il wizard: sudo pico-fan setup"
            echo "  3. Verificare stato: pico-fan status"
        else
            info "=== Aggiornamento completato! (${2} → $(cat /usr/lib/pico-fan/VERSION 2>/dev/null || echo '?')) ==="
        fi
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        error "Argomento postinst non riconosciuto: '$1'"
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
